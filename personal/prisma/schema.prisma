generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmailGroup {
  MAILBAKES
  SUPPLIERS
  INVOICES
  PERSONAL
}

enum RunStatus {
  WAITING
  NEEDS_MILLIE
  DONE
}

// One Google login for millie@mailbakes.com. The refresh token is encrypted.
model GoogleAccount {
  id              String    @id
  email           String    @default("")
  refreshTokenEnc String
  accessTokenEnc  String    @default("")
  expiresAt       DateTime?
  scopes          String    @default("")
  lastError       String    @default("")
  connectedAt     DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// A snapshot of the inbox, written only when Refresh is pressed.
model InboxMessage {
  id          String     @id
  threadId    String
  group       EmailGroup
  fromName    String     @default("")
  fromEmail   String     @default("")
  subject     String     @default("")
  snippet     String     @default("")
  bodyText    String     @default("")
  receivedAt  DateTime
  unread      Boolean    @default(false)
  attachments Json       @default("[]")
  gmailUrl    String     @default("")
  fetchedAt   DateTime   @default(now())

  @@index([group])
  @@index([receivedAt])
}

model Reminder {
  id           String    @id @default(cuid())
  title        String
  notes        String    @default("")
  dueOn        DateTime  @db.Date
  doneAt       DateTime?
  snoozedUntil DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([dueOn])
}

model RunItem {
  id        String    @id @default(cuid())
  title     String
  status    RunStatus @default(WAITING)
  notes     String    @default("")
  emailUrl  String    @default("")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([status])
}

model Briefing {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  title     String   @default("")
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

// Name and Drive folder only. No phone, bank or emergency-contact fields.
model StaffFolder {
  id         String   @id @default(cuid())
  name       String
  folderId   String
  folderName String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

enum PayslipOutcome {
  FILED
  SKIPPED_DUPLICATE
  UNMATCHED
  MISSING
  FAILED
}

model PayslipRun {
  id          String        @id @default(cuid())
  messageId   String
  subject     String        @default("")
  receivedAt  DateTime
  weekOf      DateTime      @db.Date
  emailedJess Boolean       @default(false)
  emailError  String        @default("")
  createdAt   DateTime      @default(now())
  lines       PayslipLine[]

  @@index([weekOf])
  @@index([messageId])
}

model PayslipLine {
  id          String         @id @default(cuid())
  runId       String
  run         PayslipRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  staffName   String         @default("")
  filename    String         @default("")
  outcome     PayslipOutcome
  driveFileId String         @default("")
  detail      String         @default("")

  @@index([runId])
}

// Millie's own appointments, added in the app. Never written to Google Calendar.
// Days are calendar dates and times are "HH:MM" Europe/London wall-clock, so a
// 10:00 hair appointment stays at 10:00 whatever the clocks do.
enum AppointmentType {
  HAIR
  AESTHETICS
  WORK
  MEETING
  MEAL
  PARTY
  DINNER
  TRAVEL
  OTHER
}

enum AppointmentReminder {
  NONE
  MORNING
  DAY_BEFORE
  BOTH
}

model Appointment {
  id                String              @id @default(cuid())
  title             String
  type              AppointmentType     @default(OTHER)
  startDay          DateTime            @db.Date
  // Last day it covers. Same as startDay unless it is a multi-day all-day booking.
  endDay            DateTime            @db.Date
  allDay            Boolean             @default(false)
  startTime         String              @default("")
  endTime           String              @default("")
  location          String              @default("")
  notes             String              @default("")
  reminder          AppointmentReminder @default(NONE)
  morningSentAt     DateTime?
  dayBeforeSentAt   DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([startDay])
  @@index([endDay])
}

// ---------------------------------------------------------------- diary
// One page per day: a checklist, free notes, and debriefs sent in by the other apps.

// A checklist line. Unticked lines from earlier days move to today when the diary
// opens; carriedFrom keeps the day it was first written.
model DiaryItem {
  id          String    @id @default(cuid())
  day         DateTime  @db.Date
  text        String
  doneAt      DateTime?
  carriedFrom DateTime? @db.Date
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([day])
  @@index([doneAt])
}

// Free notes for a day. One row per day.
model DiaryNote {
  day       DateTime @id @db.Date
  body      String   @default("")
  updatedAt DateTime @updatedAt
}

// A short report from another app (Operations, Daily Orders, Finance, Conversion,
// Organic). One per source, kind and day; a newer copy replaces the older one.
model Debrief {
  id         String   @id @default(cuid())
  day        DateTime @db.Date
  source     String
  kind       String   @default("daily")
  title      String
  lines      Json     @default("[]")
  link       String   @default("")
  receivedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([source, kind, day])
  @@index([day])
}
