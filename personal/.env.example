# Copy to .env for local development. Do not commit .env.

DATABASE_URL=postgresql://mailbakes:mailbakes@127.0.0.1:5432/mailbakes_personal

# At least 32 characters. Render can generate this.
SESSION_SECRET=replace-with-a-long-random-string

# Encrypts the Google refresh token. At least 32 characters. Render can generate this.
TOKEN_ENCRYPTION_KEY=replace-with-another-long-random-string

# Single password for Millie. At least 10 characters.
APP_PASSWORD=replace-with-at-least-10-characters
APP_NAME=Millie

# Public URL of this service. Used for the Google redirect.
APP_URL=http://127.0.0.1:3000

# Google Cloud OAuth client (Web application).
# Redirect URI: {APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Inbox to connect. The Connect Google screen hints this address.
GMAIL_ADDRESS=millie@mailbakes.com

# Where "Send to finance" forwards invoice emails.
FINANCE_EMAIL=accounts@mailbakes.com

# Paul sends the weekly payslips email. Jess receives a new email, not a forward.
PAUL_EMAIL=accounts@mailbakes.com
JESS_EMAIL=operations@mailbakes.com

# Optional comma-separated supplier domains, so their mail is grouped as Suppliers.
# SUPPLIER_DOMAINS=flourmill.example,packaging.example

# Calendar names that contain one of these words go in the Personal column.
# PERSONAL_CALENDAR_NAMES=personal,home,private,family

# Bearer token for the assistant API. At least 16 characters.
# openssl rand -base64 32
PERSONAL_API_TOKEN=
