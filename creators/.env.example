# Copy to .env for local development. Do not commit .env.

DATABASE_URL=postgresql://mailbakes:mailbakes@127.0.0.1:5432/mailbakes_creators

# At least 32 characters. Render can generate this.
SESSION_SECRET=replace-with-a-long-random-string

# Single password for Millie. At least 10 characters.
APP_PASSWORD=replace-with-at-least-10-characters
APP_NAME=Millie

# Public URL of this service.
APP_URL=http://127.0.0.1:3000

# Bearer token for posting inquiries. At least 16 characters.
# openssl rand -base64 32
CREATORS_API_TOKEN=

# Orders app. The token is set on the server. Do not commit it.
OPS_APP_URL=https://orders.example.com
OPS_API_TOKEN=
