generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MANAGEMENT
  TEAM
}

enum Platform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  LINKEDIN
  YOUTUBE_SHORTS
  SNAPCHAT
}

enum ContentType {
  FEED
  REEL
  STORY
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  CHANGES_REQUESTED
  AMENDMENTS_MADE
  APPROVED
  REJECTED
}

enum CommentKind {
  APPROVAL
  REJECTION
  CHANGES
  NOTE
}

enum KeyDateKind {
  LAUNCH
  KEY_DATE
}

enum MediaRole {
  ATTACHMENT
  REEL_COVER
}

// MANUAL is typed in. API is reserved for a later platform sync into the same row.
enum StatSource {
  MANUAL
  API
}

enum NoteStatus {
  IDEA
  PLANNED
  DONE
}

// One login for a platform account. META covers the Instagram professional
// account and its Facebook Page. Paid ad accounts are not stored here.
enum ConnectionPlatform {
  META
  TIKTOK
  YOUTUBE
  LINKEDIN
  SNAPCHAT
}

enum ConnectionState {
  DISCONNECTED
  CONNECTED
  NEEDS_RECONNECT
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  posts        Post[]    @relation("Author")
  reviews      Post[]    @relation("Reviewer")
  comments     Comment[]
  keyDates     KeyDate[]
  notes        Note[]
  connections  PlatformConnection[]
}

model Post {
  id            String      @id @default(cuid())
  title         String
  platforms     Platform[]
  contentType   ContentType
  plannedDate   DateTime    @db.Date
  // Wall-clock posting time in Europe/London, "HH:MM". Null on posts
  // created before times were added.
  plannedTime   String?
  status        PostStatus
  caption       String
  creativeNotes String      @default("")
  authorId      String
  author        User        @relation("Author", fields: [authorId], references: [id])
  reviewerId    String?
  reviewer      User?       @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  media         Media[]
  comments      Comment[]
  stats         PostStat[]
  fromNote      Note?
  externalPosts ExternalPost[]

  @@index([plannedDate])
  @@index([status])
}

// One row per post per platform. Empty metrics stay null so "not entered" is
// different from a real zero. A later sync upserts this same row.
model PostStat {
  id         String     @id @default(cuid())
  postId     String
  post       Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform   Platform
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  saves      Int?
  linkClicks Int?
  source     StatSource @default(MANUAL)
  syncedAt   DateTime?
  updatedAt  DateTime   @updatedAt

  @@unique([postId, platform])
  @@index([postId])
}

model Comment {
  id        String      @id @default(cuid())
  postId    String
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  kind       CommentKind
  body       String
  // Snapshot of who did this, so renaming an account does not rewrite history.
  authorName String      @default("")
  createdAt  DateTime    @default(now())

  @@index([postId])
}

model Media {
  id        String    @id @default(cuid())
  postId    String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  role      MediaRole @default(ATTACHMENT)
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  // Order within the post. Attachments are 0..n-1. Reel covers are not part of that order.
  position  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([postId])
}

model KeyDate {
  id        String      @id @default(cuid())
  title     String
  date      DateTime    @db.Date
  kind      KeyDateKind
  notes     String      @default("")
  authorId  String
  author    User        @relation(fields: [authorId], references: [id])
  createdAt DateTime    @default(now())

  @@index([date])
}

model Note {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  links       String[]   @default([])
  platform    Platform?
  date        DateTime?  @db.Date
  doThisWeek  Boolean    @default(false)
  status      NoteStatus @default(IDEA)
  // Checklist tick on the content calendar. Done notes are ticked.
  checked     Boolean    @default(false)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  postId      String?    @unique
  post        Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)
  images      NoteImage[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([date])
  @@index([authorId])
}

model NoteImage {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  @@index([noteId])
}

model PlatformConnection {
  id              String             @id @default(cuid())
  platform        ConnectionPlatform @unique
  status          ConnectionState    @default(DISCONNECTED)
  accountId       String             @default("")
  accountName     String             @default("")
  accountMeta     Json               @default("{}")
  accessTokenEnc  String             @default("")
  refreshTokenEnc String             @default("")
  expiresAt       DateTime?
  scopes          String             @default("")
  lastSyncedAt    DateTime?
  lastSyncError   String             @default("")
  connectedById   String?
  connectedBy     User?              @relation(fields: [connectedById], references: [id])
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

// Organic posts pulled from a connected account. A typed-in PostStat is never
// overwritten when matchedPostId points at a post someone edited by hand.
model ExternalPost {
  id            String    @id @default(cuid())
  platform      Platform
  externalId    String
  title         String
  caption       String    @default("")
  publishedOn   DateTime  @db.Date
  permalink     String    @default("")
  views         Int?
  likes         Int?
  comments      Int?
  shares        Int?
  saves         Int?
  linkClicks    Int?
  matchedPostId String?
  matchedPost   Post?     @relation(fields: [matchedPostId], references: [id], onDelete: SetNull)
  syncedAt      DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([platform, externalId])
  @@index([publishedOn])
  @@index([matchedPostId])
}

model FollowerSnapshot {
  id        String   @id @default(cuid())
  platform  Platform
  day       DateTime @db.Date
  followers Int
  createdAt DateTime @default(now())

  @@unique([platform, day])
}

// Day totals for an account when a platform reports a rollup rather than one row per post.
model AccountDayStat {
  id         String   @id @default(cuid())
  platform   Platform
  day        DateTime @db.Date
  views      Int?
  likes      Int?
  comments   Int?
  shares     Int?
  saves      Int?
  linkClicks Int?
  updatedAt  DateTime @updatedAt

  @@unique([platform, day])
}

model AppMeta {
  id    String @id
  value String
}

// The MailBakes Instagram header shown on /?view=grid. One row, created
// once at startup. Later edits are left alone.
model IgProfile {
  id             String        @id
  handle         String
  displayName    String
  bio            String
  link           String
  postsCount     Int
  followersCount Int
  followingCount Int
  avatarId       String?       @unique
  avatar         IgMedia?      @relation("IgAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  highlights     IgHighlight[]
  updatedAt      DateTime      @updatedAt
}

model IgHighlight {
  id        String    @id @default(cuid())
  profileId String
  profile   IgProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  position  Int
  coverId   String?   @unique
  cover     IgMedia?  @relation("IgCover", fields: [coverId], references: [id], onDelete: SetNull)

  @@index([profileId, position])
}

model IgMedia {
  id        String       @id @default(cuid())
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime     @default(now())
  avatarOf  IgProfile?   @relation("IgAvatar")
  coverOf   IgHighlight? @relation("IgCover")
}
