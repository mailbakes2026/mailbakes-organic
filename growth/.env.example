# Copy to .env for local development. Do not commit .env.

# SQLite file. Prisma resolves a relative file: path from the prisma directory.
DATABASE_URL="file:../data/growth.db"

# At least 32 characters. Render can generate this.
SESSION_SECRET=replace-with-a-long-random-string

# Single password for the people who use these apps. At least 10 characters.
APP_PASSWORD=replace-with-at-least-10-characters
APP_NAME=Millie

# Bearer tokens for POST /api/v1/ingest. At least 16 characters each.
# They must be different. openssl rand -base64 32
PAIDADS_API_TOKEN=
RETENTION_API_TOKEN=

# Meta Marketing API. Both are required before a sync. Leave blank to show Not connected.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Klaviyo. Leave blank to show Not connected.
KLAVIYO_PRIVATE_API_KEY=

# Shopify Admin API, client-credentials grant. All three are required.
# SHOPIFY_SHOP is the *.myshopify.com host, without https://.
SHOPIFY_SHOP=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Google Ads is parked. The app does not read GOOGLE_ADS_* yet.
# Later: GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_ADS_CLIENT_ID, GOOGLE_ADS_CLIENT_SECRET,
# GOOGLE_ADS_REFRESH_TOKEN, GOOGLE_ADS_CUSTOMER_ID, GOOGLE_ADS_LOGIN_CUSTOMER_ID.
