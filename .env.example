# Copy to .env for local development. Do not commit .env.

DATABASE_URL=postgresql://mailbakes:mailbakes@127.0.0.1:5432/mailbakes

# At least 32 characters. Render can generate this for you.
SESSION_SECRET=replace-with-a-long-random-string

# Management can approve, reject and request changes.
MANAGEMENT_EMAIL=millie@mailbakes.com
MANAGEMENT_PASSWORD=replace-with-at-least-10-characters
MANAGEMENT_NAME=Millie

# Team can create and edit. They cannot approve.
TEAM_EMAIL=team@mailbakes.com
TEAM_PASSWORD=replace-with-at-least-10-characters
TEAM_NAME=Content team

# Optional extra people. JSON array of {email,password,name,role}.
# EXTRA_USERS=[{"email":"studio@mailbakes.com","password":"replace-me-please","name":"Studio","role":"TEAM"}]

# Seeds example posts once, when the database is empty. Set to false before go-live
# if you do not want the examples. Deleting every post and restarting will not
# re-seed after the first boot.
SEED_SAMPLE_CONTENT=true
